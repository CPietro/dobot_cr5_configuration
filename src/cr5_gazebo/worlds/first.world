<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>10.0</update_rate>
    </plugin>
    <plugin name="gazebo_bbox_publisher" filename="libgazebo_bbox_publisher.so"/>
    
    <include>
      <uri>model://sun</uri>
    </include>
    <model name='floor'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name='visual'>
          <cast_shadows>0</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>     
        </visual>
      </link>
    </model>

    <!-- PRIMA PIANTA -->
    <model name='pianta_00'>
      <static>1</static>
      
      <link name='plant_link'>
        <pose>0 0 0 0 0 0</pose>
        <visual name='visual'>
          <geometry>
            <mesh>
              <uri>model://plant/meshes/plant.obj</uri>
              <scale>0.20 0.20 0.20</scale>  
            </mesh>
          </geometry>
        </visual>
        <collision name='collision'>
          <pose>0 0 0.25 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.125</radius>
              <length>0.5</length>
            </cylinder>
          </geometry>
        </collision>
      </link>

      <pose>0 0 0 0 0 0</pose>
    </model>

    <!-- SECONDA PIANTA -->
    <include>
      <name>pianta_01</name>
      <uri>model://plant_1_wpot</uri>
      <pose>0.5 0 0 0 0 0</pose>
    </include>

    <!-- TERZA PIANTA -->
    <model name='pianta_02'>
      <static>1</static>
      
      <link name='plant_link'>
        <pose>0 0 0 0 0 0</pose>
        <visual name='visual'>
          <geometry>
            <mesh>
              <uri>model://plant/meshes/plant.obj</uri>
              <scale>0.20 0.20 0.20</scale> 
            </mesh>
          </geometry>
        </visual>
        <collision name='collision'>
          <pose>0 0 0.25 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.125</radius>
              <length>0.5</length>
            </cylinder>
          </geometry>
        </collision>
      </link>

      <pose>1 0 0 0 0 0</pose>
    </model>

    <include>
      <name>pianta_03</name>
      <uri>model://plant_2_wpot</uri>
      <pose>1.5 0 0 0 0 0</pose>
    </include>

    <model name='pianta_04'>
      <static>1</static>
      
      <link name='plant_link'>
        <pose>0 0 0 0 0 0</pose>
        <visual name='visual'>
          <geometry>
            <mesh>
              <uri>model://plant/meshes/plant.obj</uri>
              <scale>0.20 0.20 0.20</scale>   
            </mesh>
          </geometry>
        </visual>
        <collision name='collision'>
          <geometry>
            <pose>0 0 0.25 0 0 0</pose>
            <cylinder>
              <radius>0.125</radius>
              <length>0.5</length>
            </cylinder>
          </geometry>
        </collision>
      </link>

      <pose>2 0 0 0 0 0</pose>
    </model>

    <include>
      <name>pianta_05</name>
      <uri>model://plant_3_wpot</uri>
      <pose>2.5 0 0 0 0 0</pose>
    </include>

    <!-- SECONDA RIGA -->
    <!-- PRIMA PIANTA -->
    <model name='pianta_10'>
      <static>1</static>
      
      <!-- Base della pianta (mesh esterna) -->
      <link name='plant_link'>
        <pose>0 0 0 0 0 0</pose>
        <visual name='visual'>
          <geometry>
            <mesh>
              <uri>model://plant/meshes/plant.obj</uri>
              <scale>0.20 0.20 0.20</scale> 
            </mesh>
          </geometry>
        </visual>
        <collision name='collision'>
          <pose>0 0 0.25 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.125</radius>
              <length>0.5</length>
            </cylinder>
          </geometry>
        </collision>
      </link>

      <pose>0 0.5 0 0 0 0</pose>
    </model>

    <!-- SECONDA PIANTA -->
    <model name='pianta_11'>
      <static>1</static>
      
      <link name='plant_link'>
        <pose>0 0 0 0 0 0</pose>
        <visual name='visual'>
          <geometry>
            <mesh>
              <uri>model://plant/meshes/plant.obj</uri>
              <scale>0.20 0.20 0.20</scale>  
            </mesh>
          </geometry>
        </visual>
        <collision name='collision'>
          <pose>0 0 0.25 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.125</radius>
              <length>0.5</length>
            </cylinder>
          </geometry>
        </collision>
      </link>

      <pose>0.5 0.5 0 0 0 0</pose>
    </model>

    <!-- TERZA PIANTA -->
    <model name='pianta_12'>
      <static>1</static>
      
      <link name='plant_link'>
        <pose>0 0 0 0 0 0</pose>
        <visual name='visual'>
          <geometry>
            <mesh>
              <uri>model://plant/meshes/plant.obj</uri>
              <scale>0.20 0.20 0.20</scale>  
            </mesh>
          </geometry>
        </visual>
        <collision name='collision'>
          <pose>0 0 0.25 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.125</radius>
              <length>0.5</length>
            </cylinder>
          </geometry>
        </collision>
      </link>

      <pose>1 0.5 0 0 0 0</pose>
    </model>

    <include>
      <name>ostacolo_cestino</name>
      <uri>model://recycle_bin_red</uri>
      <pose>-0.4 0.2 0 0 0 0</pose>
    </include>

    <include>
      <name>ostacolo_laptop</name>
      <uri>model://labtop_mac_1</uri>
      <pose>1.5 0.5 0 0 0 0</pose>
    </include>

    <include>
      <name>ostacolo_lampada</name>
      <uri>model://lamp_table_small</uri>
      <pose>0.25 0.25 0 0 0 0</pose>
    </include>

  </world>
</sdf>